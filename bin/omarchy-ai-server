#!/usr/bin/env python3
"""omarchy-ai-server — serve the local chat page and extract text from files.

A static file server cannot run pdftotext or tesseract, and the chat page needs
both to accept attachments. Everything here is local and short-lived: an upload
goes to a temp file, a *fixed* binary reads it, the temp file is deleted. No
shell is ever involved, so no upload can turn into a command.

Endpoints:
    GET  /            the page (static, from ROOT)
    GET  /theme.css   the desktop palette, as CSS variables
    POST /extract     ?kind=pdf|image, raw body -> JSON {text, chars, ...}

Bound to loopback only.
"""

import json
import os
import re
import subprocess
import sys
import tempfile
from http.server import SimpleHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import parse_qs, unquote, urlparse

ROOT = os.environ.get(
    "OMARCHY_AI_ROOT",
    # bin/omarchy-ai-server -> the repository root, resolved through symlinks
    # so the launcher can live in ~/.local/bin and still find its own files.
    os.path.dirname(os.path.dirname(os.path.realpath(__file__))),
)
HOST = "127.0.0.1"
PORT = int(os.environ.get("OMARCHY_AI_PORT", "8099"))

MAX_UPLOAD = 25 * 1024 * 1024   # 25 MB
MAX_CHARS = 8000                # keep attachments from eating the context window
TIMEOUT = 90                    # seconds per external tool
MAX_OCR_PAGES = 5               # scanned-PDF fallback

# theme-switch writes this file for Waybar; the chat window reads the same
# tokens so the page follows the desktop instead of keeping its own palette.
COLORS_CSS = os.environ.get(
    "OMARCHY_AI_COLORS", os.path.expanduser("~/.config/waybar/colors.css"))

# CSS variable in the page  <-  GTK colour token in colors.css.
# 'bg' prefers bg_solid: colors.css gives bg an alpha for the Waybar pill, and a
# window background must not be see-through.
THEME_MAP = {
    "bg": ("bg_solid", "bg"),
    "fg": ("fg",),
    "muted": ("muted",),
    "accent": ("accent",),
    "accent2": ("accent2",),
    "error": ("critical",),
    "warning": ("warning",),
    "border": ("border",),
}


def norm_colour(value):
    """rgba(45,53,59,0.86) -> #2d353b; #abc -> #aabbcc. Alpha is dropped: the
    page is one opaque window, and every tint it needs is mixed from opaque
    tokens, so a light theme needs no second set of rules."""
    value = value.strip()
    m = re.fullmatch(
        r"rgba?\(\s*([\d.]+)\s*,\s*([\d.]+)\s*,\s*([\d.]+)\s*(?:,\s*[\d.]+\s*)?\)",
        value)
    if m:
        return "#%02x%02x%02x" % tuple(int(round(float(x))) for x in m.group(1, 2, 3))
    m = re.fullmatch(r"#([0-9a-fA-F]{3})", value)
    if m:
        return "#" + "".join(c * 2 for c in m.group(1)).lower()
    return value


def read_colours():
    """Raw values, exactly as colors.css writes them: the page consumes them as
    CSS, and rgba() survives the trip (dropping alpha would turn a soft border
    into a bright one)."""
    tokens = {}
    try:
        with open(COLORS_CSS, encoding="utf-8") as fh:
            for line in fh:
                m = re.match(r"\s*@define-color\s+([\w-]+)\s+(.+?);", line)
                if m:
                    tokens[m.group(1)] = m.group(2).strip()
    except OSError:
        return {}
    return tokens


_theme_cache = {"mtime": None, "css": ":root{}\n"}


def theme_css():
    """A two-line stylesheet, regenerated only when colors.css changes."""
    try:
        mtime = os.stat(COLORS_CSS).st_mtime
    except OSError:
        return ":root{}\n"
    if _theme_cache["mtime"] == mtime:
        return _theme_cache["css"]

    tokens = read_colours()
    declarations = []
    for var, names in THEME_MAP.items():
        for name in names:
            if name in tokens:
                value = tokens[name]
                # Only --bg must be forced opaque (a window background cannot be
                # see-through). Everything else is passed through as written:
                # colors.css uses rgba() for --border, which CSS understands.
                if var == "bg":
                    value = norm_colour(value)
                declarations.append(f"--{var}:{value}")
                break

    css = "/* generated from %s */\n:root{%s}\n" % (COLORS_CSS, ";".join(declarations))
    _theme_cache.update(mtime=mtime, css=css)
    return css


def run(cmd):
    """Run a fixed binary. Returns (ok, stdout, stderr)."""
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=TIMEOUT)
    except FileNotFoundError:
        return False, "", f"{cmd[0]} is not installed"
    except subprocess.TimeoutExpired:
        return False, "", f"{cmd[0]} took longer than {TIMEOUT}s"
    return r.returncode == 0, r.stdout, r.stderr


def extract_pdf(path):
    """Text layer first; if the PDF is a scan, render pages and OCR them."""
    ok, out, err = run(["pdftotext", "-layout", "-enc", "UTF-8", path, "-"])
    text = out if ok else ""
    if len(text.strip()) >= 40:
        return text, ""

    # Almost no text: a scanned document. Render up to MAX_OCR_PAGES and OCR.
    with tempfile.TemporaryDirectory() as td:
        ok, _, err = run([
            "pdftoppm", "-r", "150", "-png",
            "-f", "1", "-l", str(MAX_OCR_PAGES),
            path, os.path.join(td, "page"),
        ])
        pages = sorted(f for f in os.listdir(td) if f.endswith(".png"))
        if not pages:
            return "", "no text layer, and the pages could not be rendered"

        parts = []
        for page in pages:
            ok, out, _ = run(["tesseract", os.path.join(td, page), "stdout", "-l", "eng+fra"])
            if ok and out.strip():
                parts.append(out.strip())
        if not parts:
            return "", "no text found — the scan may be too low-resolution"
        return "\n\n".join(parts), f"scanned PDF, OCR of {len(pages)} page(s)"


def extract_image(path):
    ok, out, err = run(["tesseract", path, "stdout", "-l", "eng+fra"])
    if not ok:
        return "", (err.strip().splitlines() or ["OCR failed"])[-1]
    if not out.strip():
        return "", "no text found in the image"
    return out, ""


class Handler(SimpleHTTPRequestHandler):
    def __init__(self, *args, **kwargs):
        super().__init__(*args, directory=ROOT, **kwargs)

    # -- helpers ---------------------------------------------------------
    def _json(self, code, obj):
        body = json.dumps(obj).encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, fmt, *args):
        # Keep the terminal quiet; only errors are interesting.
        if args and str(args[1] if len(args) > 1 else "").startswith("4"):
            super().log_message(fmt, *args)

    # -- GET / HEAD ------------------------------------------------------
    def do_GET(self):
        if urlparse(self.path).path == "/theme.css":
            return self._css(theme_css())
        if self._hidden():
            return self._json(404, {"error": "not found"})
        return super().do_GET()

    def do_HEAD(self):
        if urlparse(self.path).path == "/theme.css":
            body = theme_css().encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "text/css; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            return
        if self._hidden():
            return self._json(404, {"error": "not found"})
        return super().do_HEAD()

    def _hidden(self):
        """Hidden paths are not part of the page. /.git/config alone hands out
        the remote URL, and the rest of the directory is the whole history —
        nothing here was meant to be published, loopback or not."""
        path = unquote(urlparse(self.path).path)
        return any(part.startswith(".") for part in path.split("/") if part)

    def _css(self, css):
        body = css.encode("utf-8")
        self.send_response(200)
        self.send_header("Content-Type", "text/css; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def end_headers(self):
        # The page is edited in place; a cached copy is always the wrong one.
        path = urlparse(self.path).path
        if path in ("/", "/theme.css") or path.endswith(".html"):
            self.send_header("Cache-Control", "no-store, must-revalidate")
        super().end_headers()

    # -- POST /extract ---------------------------------------------------
    def do_POST(self):
        parsed = urlparse(self.path)
        if parsed.path != "/extract":
            return self._json(404, {"error": "not found"})

        kind = (parse_qs(parsed.query).get("kind") or ["image"])[0]
        if kind not in ("pdf", "image"):
            return self._json(400, {"error": "kind must be pdf or image"})

        try:
            length = int(self.headers.get("Content-Length") or 0)
        except ValueError:
            length = 0
        if length <= 0:
            return self._json(400, {"error": "empty upload"})
        if length > MAX_UPLOAD:
            return self._json(413, {"error": "file is larger than 25 MB"})

        data = self.rfile.read(length)
        suffix = ".pdf" if kind == "pdf" else ".png"
        fd, path = tempfile.mkstemp(suffix=suffix)
        try:
            with os.fdopen(fd, "wb") as fh:
                fh.write(data)
            text, note = extract_pdf(path) if kind == "pdf" else extract_image(path)
        except Exception as exc:                       # noqa: BLE001
            return self._json(500, {"error": f"extraction failed: {exc}"})
        finally:
            try:
                os.unlink(path)
            except OSError:
                pass

        text = (text or "").strip()
        if not text:
            return self._json(200, {"text": "", "chars": 0, "truncated": False,
                                    "note": note or "nothing readable found"})

        truncated = len(text) > MAX_CHARS
        if truncated:
            text = text[:MAX_CHARS]

        return self._json(200, {
            "text": text,
            "chars": len(text),
            "truncated": truncated,
            "note": note,
        })


def main():
    if not os.path.isdir(ROOT):
        sys.exit(f"no such directory: {ROOT}")
    try:
        srv = ThreadingHTTPServer((HOST, PORT), Handler)
    except OSError as exc:
        sys.exit(f"cannot listen on {HOST}:{PORT}: {exc}")
    print(f"serving {ROOT} on http://{HOST}:{PORT}", file=sys.stderr, flush=True)
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
